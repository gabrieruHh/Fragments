<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:id="@+id/containerMain"
    tools:context=".ui.screensdashboard.addsales.TestProductActivity">

    <!-- Top App Bar (sticky header) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/muted_foreground"
            app:title="Nova Oferta"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.NovaOferta.Title" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- ===== SEÇÃO: MÍDIA ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mídia"
                android:textAppearance="@style/TextAppearance.NovaOferta.SectionTitle" />

            <!-- Upload area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <!-- Dashed upload box -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnAddPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    app:cardBackgroundColor="@color/input_50"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="2dp">

                    <!-- Dashed border is drawn programmatically in Activity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_dashed_border">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/muted_foreground"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Adicionar fotos"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/muted_foreground" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thumbnail row -->
                <LinearLayout
                    android:id="@+id/thumbnailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <!-- Add more thumbnail -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardBackgroundColor="@color/secondary_30"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/muted_foreground"
                            android:contentDescription="@null" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </LinearLayout>

            <!-- Spacing between sections -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <!-- ===== SEÇÃO: INFORMAÇÕES BÁSICAS ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informações Básicas"
                android:textAppearance="@style/TextAppearance.NovaOferta.SectionTitle" />

            <!-- Tipo de Imóvel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de Imóvel"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/foreground" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/spinnerTipoImovel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/input"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvTipoImovel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Selecione"
                            android:textSize="14sp"
                            android:textColor="@color/foreground" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/muted_foreground"
                            android:contentDescription="@null" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Tipo de Oferta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de Oferta"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/foreground" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/spinnerTipoOferta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/input"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvTipoOferta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Selecione"
                            android:textSize="14sp"
                            android:textColor="@color/foreground" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/muted_foreground"
                            android:contentDescription="@null" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Spacing between sections -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <!-- ===== SEÇÃO: DETALHES DO IMÓVEL ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalhes do Imóvel"
                android:textAppearance="@style/TextAppearance.NovaOferta.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/input_20"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Quartos row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Quartos"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/foreground" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuartosDecrease"
                            style="@style/Widget.NovaOferta.CounterButton.Neutral"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:icon="@drawable/ic_minus"
                            android:contentDescription="Diminuir quartos" />

                        <TextView
                            android:id="@+id/tvQuartos"
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="2"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/foreground"
                            android:gravity="center" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuartosIncrease"
                            style="@style/Widget.NovaOferta.CounterButton.Primary"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:icon="@drawable/ic_plus"
                            android:contentDescription="Aumentar quartos" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border" />

                    <!-- Banheiros row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Banheiros"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/foreground" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBanheirosDecrease"
                            style="@style/Widget.NovaOferta.CounterButton.Neutral"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:icon="@drawable/ic_minus"
                            android:contentDescription="Diminuir banheiros" />

                        <TextView
                            android:id="@+id/tvBanheiros"
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="1"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/foreground"
                            android:gravity="center" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBanheirosIncrease"
                            style="@style/Widget.NovaOferta.CounterButton.Primary"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:icon="@drawable/ic_plus"
                            android:contentDescription="Aumentar banheiros" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border" />

                    <!-- Salas row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Salas"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/foreground" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSalasDecrease"
                            style="@style/Widget.NovaOferta.CounterButton.Neutral"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:icon="@drawable/ic_minus"
                            android:contentDescription="Diminuir salas" />

                        <TextView
                            android:id="@+id/tvSalas"
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="1"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/foreground"
                            android:gravity="center" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSalasIncrease"
                            style="@style/Widget.NovaOferta.CounterButton.Primary"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:icon="@drawable/ic_plus"
                            android:contentDescription="Aumentar salas" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Spacing between sections -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <!-- ===== SEÇÃO: LOCALIZAÇÃO ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Localização"
                android:textAppearance="@style/TextAppearance.NovaOferta.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <!-- Map label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Localização no mapa"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/foreground" />

                <!-- Map preview -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mapPreview"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <!-- MapView or static map image -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgMapPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/placeholder_map"
                            android:contentDescription="Mapa de localização" />

                        <!-- Pin marker -->
                        <LinearLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_map_pin"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_map_pin"
                                app:tint="@color/primary_foreground"
                                android:contentDescription="@null" />

                        </LinearLayout>

                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Use current location button -->
                <LinearLayout
                    android:id="@+id/btnCurrentLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_navigation"
                        android:rotation="45"
                        app:tint="@color/primary"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Usar localização atual"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/primary" />

                </LinearLayout>

                <!-- Bairro field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bairro"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/foreground" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        app:cardBackgroundColor="@color/input"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center_vertical">

                            <EditText
                                android:id="@+id/etBairro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Informe o bairro"
                                android:textColorHint="@color/muted_foreground"
                                android:textSize="14sp"
                                android:textColor="@color/foreground"
                                android:background="@null"
                                android:inputType="text"
                                android:maxLines="1" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_search"
                                app:tint="@color/muted_foreground"
                                android:contentDescription="@null" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <!-- Spacing before CTA -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- ===== CTA: PUBLICAR OFERTA ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicarOferta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Publicar Oferta"
                android:textSize="16sp"
                android:fontFamily="@font/inter_medium"
                app:backgroundTint="@color/primary"
                android:textColor="@color/primary_foreground"
                app:cornerRadius="8dp"
                app:elevation="0dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>